# Example secrets file - DO NOT commit with real values
# Copy to secrets.yaml and fill in your values
apiVersion: v1
kind: Secret
metadata:
  name: nebula-secrets
type: Opaque
stringData:
  # RGW Connection Presets
  # NEBULA_RGW_1_NAME: "My RGW Cluster"
  # NEBULA_RGW_1_ENDPOINT: "https://rgw.example.com"
  # NEBULA_RGW_1_ACCESS_KEY: "your-access-key"
  # NEBULA_RGW_1_SECRET_KEY: "your-secret-key"
  # NEBULA_RGW_1_REGION: "us-east-1"
  # NEBULA_RGW_1_PROXY: "true"
